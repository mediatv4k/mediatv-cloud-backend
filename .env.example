# MediaTV Cloud Backend — variables de entorno requeridas (Render → Environment)
# Copia este archivo como referencia; NUNCA subas un .env real con valores reales
# a un repositorio. Este server.js no carga dotenv (no es necesario en Render:
# el propio panel de "Environment" inyecta estas variables en process.env).

# ---------------------------------------------------------------------------
# Firebase (antes hardcodeado en server.js; ahora obligatorio por variable)
# Los valores viven en la consola de Firebase → Configuración del proyecto →
# tus apps → SDK de configuración.
# ---------------------------------------------------------------------------
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=mediatv4k-30eb0.firebaseapp.com
FIREBASE_PROJECT_ID=mediatv4k-30eb0
FIREBASE_STORAGE_BUCKET=mediatv4k-30eb0.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=768500262681
FIREBASE_APP_ID=1:768500262681:web:9795dd138f947503e08788

# ---------------------------------------------------------------------------
# Secreto compartido para el middleware de autenticación (requireAdminSecret).
# Se envía como header `x-api-key` en cada POST protegido, o como querystring
# `?token=` en GET /qr. Genera un valor largo y aleatorio, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# El mismo valor debe configurarse en el frontend (panel admin) para que las
# llamadas a este backend (saveBotCloudConfig, forzarBarridoCloud, etc. en
# js/ui.js) sigan funcionando tras este blindaje.
# ---------------------------------------------------------------------------
ADMIN_API_SECRET=

# ---------------------------------------------------------------------------
# Opcional: habilita orígenes de localhost para pruebas locales de CORS.
# En Render (producción) se deja sin definir o en "production".
# ---------------------------------------------------------------------------
NODE_ENV=production

# Puerto (Render lo inyecta automáticamente; solo relevante en local)
PORT=10000
